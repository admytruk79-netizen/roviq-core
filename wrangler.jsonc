{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roviq-core",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DEPLOY_REVISION": "rebuild-neon-core-phase0"
  }
}
