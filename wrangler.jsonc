{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roviq-core",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "JWT_ISSUER": "roviq-core",
    "JWT_AUDIENCE": "roviq-apps",
    "TRIAGE_DEPLOYMENT_MODE": "shadow",
    "TRIAGE_AUTO_CONFIDENCE_THRESHOLD": "0.90"
  },
  "containers": [
    {
      "class_name": "RoviqCoreContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "basic",
      "rollout_step_percentage": [10, 100],
      "rollout_active_grace_period": 120
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROVIQ_CORE_CONTAINER",
        "class_name": "RoviqCoreContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoviqCoreContainer"]
    }
  ]
}
