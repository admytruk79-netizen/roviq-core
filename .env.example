PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roviq
ADMIN_API_KEY=change-me-bootstrap-key
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=roviq-core
JWT_AUDIENCE=roviq-apps
# Set true only for local/bootstrap use. Production should be false.
ALLOW_DEV_HEADERS=true

# AI triage engine. Start production pilots in shadow mode.
TRIAGE_DEPLOYMENT_MODE=shadow
TRIAGE_AUTO_CONFIDENCE_THRESHOLD=0.90
TRIAGE_MODEL_PROVIDER=openai-compatible
TRIAGE_MODEL_ENDPOINT=
TRIAGE_MODEL_API_KEY=
TRIAGE_MODEL=
# Optional when routing model calls through Cloudflare AI Gateway.
TRIAGE_GATEWAY_ID=

# One-time bootstrap: on first migration run, if no admin identity exists yet,
# creates one with these credentials. Safe to leave unset after first use;
# it no-ops once any admin identity exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Twilio SMS, used for the 'sms' notification channel's 'twilio' provider (real customer status
# texts -- see src/services/notifications.ts and cloudflare/worker.js's processNotificationBatchNative).
# Leave unset to run without SMS: notifications still queue, they just fail with a clear
# 'twilio_not_configured' reason instead of sending anything. Once set, an admin must still
# explicitly enable the channel: PUT /api/admin/notifications/channels/sms
# {"provider":"twilio","enabled":true}. In production these are Cloudflare secrets
# (wrangler secret put TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER), never
# committed vars.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
